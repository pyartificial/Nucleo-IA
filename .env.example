# Secrets / configuration template for La Granja de IA / Núcleo IA
INSTANCIAS=0
PUERTO_BASE=11434
OLLAMA_BASE_DIR="$HOME/ollama_instances"
CONTEXT_LENGTH=131072
PROXY_HOST="127.0.0.1"
PROXY_PORT=8080
AUTH_ENABLED=false
NUCLEO_API_KEY=
NUCLEO_ADMIN_KEY=
PERFIL_USO=personal
# Solo hace falta agregar orígenes concretos cuando una interfaz web externa autorizada usa el proxy.
# En modo Profesional nunca uses *.
CORS_ALLOW_ORIGINS=
ALLOWED_HOSTS=
MAX_REQUEST_BODY_BYTES=16777216
PROCESAMIENTO_PERMITIDO=local_y_cloud
SOLO_MODELOS_GRATUITOS=false
PERMITIR_OLLAMA_REMOTO=false
# Las variantes de video que no estén confirmadas como gratuitas requieren
# habilitación explícita para evitar consumos inesperados.
NUCLEO_HABILITAR_MODELOS_VIDEO_NO_GRATUITOS=false
NUCLEO_HABILITAR_MODELOS_IMAGEN_NO_GRATUITOS=false
NUCLEO_HABILITAR_MODELOS_VOZ_NO_GRATUITOS=false
CORS_ALLOW_CREDENTIALS=false
ACTIVE_MODEL="auto"
SERVICIOS_ACTIVOS=ollama,groq,tokenrouter,xkiro,tokenharbor,cloudflare,nvidia,openrouter,google,cohere,zhipu
ROTACION_TOP_N=3
MODO_ROTACION=modelos
MAX_REQUESTS_POR_CUENTA_HORA=15
MAX_REQUESTS_POR_CUENTA_SEMANA=200
MAX_REQUESTS_GLOBAL_MINUTO=90
CURL_TIMEOUT=40
MAX_TOKENS_TEST=1
TIMEOUT_CLOUD=120
OPENCLAW_PUERTO_DEFAULT=18789

# Configuración opcional de Ultra-Fallback (desactivado por defecto)
ULTRA_FALLBACK_HABILITADO=false
ULTRA_FALLBACK_CUENTA=acc1
ULTRA_FALLBACK_MODELO=qwen2.5-coder:3b

# Credenciales de Proveedores (Cargar con scripts/agregar_*.sh o python granja.py add-key)
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
AGNES_API_KEY=
AION_API_KEY=
AIRFORCE_API_KEY=
ANYAPI_API_KEY=
BAZAARLINK_API_KEY=
DREAMPROMPTING_API_KEY=
HF_TOKEN=
ORCAROUTER_API_KEY=
REQUESTY_API_KEY=
ROUTEWAY_API_KEY=
SEALION_API_KEY=
UNOROUTER_API_KEY=
OLLAMA_API_KEY=
SPEECHIFY_API_KEY=
TOKENROUTER_API_KEY=
NVIDIA_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=
SILICONFLOW_API_KEY=
ZHIPU_API_KEY=
XKIRO_API_KEY=
TOKENHARBOR_API_KEY=
# TTS secundario opcional (no participa en chat ni ranking general)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
